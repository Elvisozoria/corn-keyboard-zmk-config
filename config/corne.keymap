#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        /*
        * 1. DTAP_TAB: Al pulsar una vez envía TAB, al pulsar dos veces rápidamente envía ESC.
        */

        dtap_tab: dtap_tab {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp TAB>, <&kp ESC>, <&kp ESC>;
        };

        /*
        * 2. SS_DANCE (pulgar izquierdo vacío): 1 toque no hace nada,
        *    2 toques = captura de pantalla completa (Cmd+Ctrl+Shift+3),
        *    3 toques = captura de un área (Cmd+Ctrl+Shift+4). Ambas van al portapapeles.
        */

        ss_dance: ss_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&none>, <&kp LG(LC(LS(N3)))>, <&kp LG(LC(LS(N4)))>;
        };

        /*
        * 3. BT_CLEAR: borra el perfil Bluetooth actual SOLO si se sostiene 1 segundo.
        *    Un toque accidental no hace nada. Uso: &bt_clear BT_CLR_CMD 0
        */

        bt_clear: bt_clear {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <1000>;
            bindings = <&bt>, <&none>;
        };
    };

    combos {
        compatible = "zmk,combos";

        layer_a {
            bindings = <&lt 1 LC(A)>;
            key-positions = <13 37>;
            timeout-ms = <500>;
            layers = <0>;
        };

        layer_s {
            bindings = <&lt 2 LC(S)>;
            key-positions = <14 37>;
            layers = <0>;
            timeout-ms = <300>;
        };

        layer_d {
            bindings = <&lt 3 LC(D)>;
            key-positions = <15 37>;
            layers = <0>;
            timeout-ms = <200>;
        };

        screenshot {
            bindings = <&kp LG(LC(LS(N4)))>;
            key-positions = <37 4>;
            slow-release;
            layers = <0>;
            timeout-ms = <500>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |tab/esc|  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT  |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
            //                     | GUI | 📸  | SPC |   | ENT | GUI  | ALT |

            bindings = <
&dtap_tab  &kp Q  &kp W  &kp E     &kp R      &kp T        &kp Y    &kp U     &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D     &kp F      &kp G        &kp H    &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V      &kp B        &kp N    &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                         &kp LGUI  &ss_dance  &kp SPACE    &kp RET  &kp RGUI  &kp RALT
            >;
        };

        numbers_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |     |     |     |     |     |   |     |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL |     |     |     |     |     |   |     |  4  |  5  |  6  |  -  |  +   |
            // | SHFT |     |     |     |     |     |   |     |  1  |  2  |  3  |  /  |  *   |
            //                    | GUI |     | SPC |   | ENT |  0  |  .  |

            bindings = <
&kp TAB           &none  &none  &none     &none   &none        &none    &kp N7  &kp N8   &kp N9  &kp N0     &kp BSPC
&kp LEFT_CONTROL  &none  &none  &none     &none   &none        &none    &kp N4  &kp N5   &kp N6  &kp MINUS  &kp PLUS
&kp LSHFT         &none  &none  &none     &none   &none        &none    &kp N1  &kp N2   &kp N3  &kp FSLH   &kp ASTRK
                                &kp LGUI  &trans  &kp SPACE    &kp RET  &kp N0  &kp DOT
            >;
        };

        icons_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |     |  &  |  $  |  %  |   |  @  |  (  |  )  |  {  |  }  | BSPC |
            // | CTRL |  *  |     |  #  |  +  |  =  |   |  -  |  [  |  ]  |  "  |  :  |  `   |
            // | SHFT |  ~  |     |  /  |  |  |  \  |   |  _  |  <  |  >  |  ^  |  ?  | SHFT |
            //                    | GUI |     | SPC |   | ENT | GUI | ALT |

            bindings = <
&kp TAB           &kp EXCL      &trans  &kp AMPERSAND  &kp DLLR  &kp PRCNT        &kp AT     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp BSPC
&kp LEFT_CONTROL  &kp ASTERISK  &trans  &kp HASH       &kp PLUS  &kp EQUAL        &kp MINUS  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp DQT         &kp COLON        &kp GRAVE
&kp LEFT_SHIFT    &kp TILDE     &trans  &kp SLASH      &kp PIPE  &kp BACKSLASH    &kp UNDER  &kp LESS_THAN         &kp GREATER_THAN       &kp CARET       &kp QUESTION     &kp RIGHT_SHIFT
                                        &kp LGUI       &trans    &kp SPACE        &kp RET    &kp RIGHT_COMMAND     &kp RALT
            >;
        };

        arrows_layer: arrows_layer {
            // -----------------------------------------------------------------------------------------
            // |      |CLR* |     |     |     |     |   |     |     | UP  |     |     | BSPC |
            // | CTRL |     |     |     |     |     |   |     |LEFT |DOWN |RIGHT|     |      |
            // | SHFT |     |     |     |     |     |   |     | BT1 | BT2 | BT3 |     | SHFT |
            //                    | GUI |     | SPC |   | ENT | GUI | ALT |
            // CLR* = borra el perfil Bluetooth actual, solo sosteniendo 1 segundo.
            // BT1-3 están donde 1 2 3 en la capa numbers.

            bindings = <
&trans            &bt_clear BT_CLR_CMD 0  &trans  &trans    &trans  &trans       &trans   &trans             &kp UP          &trans          &trans  &kp BACKSPACE
&kp LEFT_CONTROL  &trans                  &trans  &trans    &trans  &trans       &trans   &kp LEFT           &kp DOWN        &kp RIGHT       &trans  &trans
&kp LEFT_SHIFT    &trans                  &trans  &trans    &trans  &trans       &trans   &bt BT_SEL 0       &bt BT_SEL 1    &bt BT_SEL 2    &trans  &kp RIGHT_SHIFT
                                                  &kp LGUI  &trans  &kp SPACE    &kp RET  &kp RIGHT_COMMAND  &kp RALT
            >;
        };
    };
};
